{
  "name": "parts-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "CHROME_BIN=/usr/bin/google-chrome-stable ng test --no-watch --code-coverage --browsers=ChromeHeadless",
    "test:coverage": "ng test --no-watch --code-coverage --browsers=ChromeHeadless",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@danielmoncada/angular-datetime-picker": "^22.0.0",
    "@mdi/font": "^7.4.47",
    "@sgratzl/chartjs-chart-boxplot": "4.4.4",
    "@types/gtag.js": "^0.0.20",
    "angularx-qrcode": "^22.0.1",
    "blueimp-load-image": "^5.16.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "4.5.0",
    "dexie": "^4.3.0",
    "file-saver": "^2.0.5",
    "ngx-device-detector": "^12.0.0",
    "ngx-image-cropper": "^9.1.7",
    "rxjs": "7.8.0",
    "tslib": "2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^9.39.1",
    "@types/blueimp-load-image": "^5.16.0",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "5.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.9.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.3"
  }
}
